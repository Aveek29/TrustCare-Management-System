PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trustcare?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-secure-random-string
ALLOWED_ORIGINS=http://localhost:3000,https://trust-care-management-system.vercel.app
OPENAI_API_KEY=sk-mock-key
GROQ_API_KEY=your_groq_api_key_here

# Healthcare Aggregator
REDIS_URL=redis://localhost:6379
SCRAPER_DISCOVERY_INTERVAL=21600000
SCRAPER_UPDATE_INTERVAL=3600000
SCRAPER_CLEANUP_INTERVAL=604800000
SCRAPER_STALE_DAYS=30
