PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trustcare?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-secure-random-string
ALLOWED_ORIGINS=http://localhost:3000,https://trust-care-management-system.vercel.app
OPENAI_API_KEY=sk-mock-key
# Groq LLM (optional). Leave empty to use the built-in mock assistant.
# Model list changes over time; available models are auto-detected with fallbacks.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Care Recommendation Engine (optional ML ranking service)
# Leave ML_SERVICE_URL empty to use the deterministic rule-based fallback only.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TOKEN=
ML_TIMEOUT_MS=800

# Healthcare Aggregator
REDIS_URL=redis://localhost:6379
SCRAPER_DISCOVERY_INTERVAL=21600000
SCRAPER_UPDATE_INTERVAL=3600000
SCRAPER_CLEANUP_INTERVAL=604800000
SCRAPER_STALE_DAYS=30
